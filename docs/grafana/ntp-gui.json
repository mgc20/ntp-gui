            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Anfragen/s",
      "description": "Beantwortete NTP-Anfragen pro Sekunde (5-Minuten-Mittel).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
